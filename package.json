{
  "name": "cashscript-bchd-provider",
  "version": "0.1.0",
  "description": "CashScript NetworkProvider backed by a BCHD node over gRPC-Web, for browsers and Node.js",
  "license": "MIT",
  "author": "mr-zwets",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "proto"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "generate": "buf generate",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/unit",
    "test:regtest": "NODE_EXTRA_CA_CERTS=.regtest/rpc.cert vitest run test/regtest"
  },
  "peerDependencies": {
    "cashscript": "^0.14.0"
  },
  "dependencies": {
    "@bitauth/libauth": "^3.1.0-next.8",
    "@bufbuild/protobuf": "^2.17.0",
    "@connectrpc/connect": "^2.3.0",
    "@connectrpc/connect-web": "^2.3.0"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.75.0",
    "@bufbuild/protoc-gen-es": "^2.17.0",
    "@connectrpc/connect-node": "^2.3.0",
    "@types/node": "^24.0.0",
    "cashscript": "^0.14.0",
    "typescript": "^5.9.2",
    "vitest": "^5.0.1"
  }
}
